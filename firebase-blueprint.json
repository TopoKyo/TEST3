{
  "entities": {
    "User": {
      "title": "User",
      "description": "System users for facial recognition and personnel management.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "faceDescriptor": { "type": "array", "items": { "type": "number" } },
        "image": { "type": "string", "format": "data-url" }
      },
      "required": ["id", "name", "faceDescriptor", "image"]
    },
    "AttendanceLog": {
      "title": "AttendanceLog",
      "description": "Clock-in/out and break logs for users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "type": { "type": "string", "enum": ["arrival", "break_start", "break_end", "departure"] },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "type", "timestamp"]
    },
    "Product": {
      "title": "Product",
      "description": "Inventory products.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "description": { "type": "string" },
        "unit": { "type": "string" },
        "lowStockThreshold": { "type": "number" },
        "location": { "type": "string" }
      },
      "required": ["id", "name", "unit", "lowStockThreshold"]
    },
    "InventoryMovement": {
      "title": "InventoryMovement",
      "description": "Stock movements (entry/exit).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "type": { "type": "string", "enum": ["entry", "exit"] },
        "quantity": { "type": "number" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "observation": { "type": "string" },
        "reason": { "type": "string" }
      },
      "required": ["id", "productId", "productName", "type", "quantity", "userId", "userName", "timestamp"]
    },
    "WorkLog": {
      "title": "WorkLog",
      "description": "Daily work reports.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "reportNumber": { "type": "number" },
        "project": { "type": "string" },
        "client": { "type": "string" },
        "residentHead": { "type": "string" },
        "workAddress": { "type": "string" },
        "dayOfWeek": { "type": "string" },
        "processItem": { "type": "string" },
        "advancePercentage": { "type": "number" },
        "advanceM2": { "type": "number" },
        "weather": { "type": "object" },
        "personnel": { "type": "array" },
        "activities": { "type": "array" },
        "safety": { "type": "object" },
        "problems": { "type": "array" },
        "nextDayPlan": { "type": "array" },
        "photos": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "date", "reportNumber", "project", "client"]
    },
    "WishListItem": {
      "title": "WishListItem",
      "description": "Daily needs and items for the following day.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "item": { "type": "string" },
        "category": { "type": "string", "enum": ["material", "herramienta", "tarea", "otro"] },
        "targetDate": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["pendiente", "listo"] },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "createdBy": { "type": "string" }
      },
      "required": ["id", "item", "category", "targetDate", "status", "createdAt", "createdBy"]
    },
    "ProjectContext": {
      "title": "ProjectContext",
      "description": "Global project information for report analysis.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "technicalSpecs": { "type": "string" },
        "objectives": { "type": "string" },
        "generalDescription": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name"]
    },
    "SkillEvaluation": {
      "title": "SkillEvaluation",
      "description": "Daily soft skills evaluation for operators.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "supervisorId": { "type": "string" },
        "supervisorName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "scores": { "type": "object" },
        "average": { "type": "number" },
        "positiveObservations": { "type": "string" },
        "negativeObservations": { "type": "string" },
        "generalComments": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "userName", "supervisorId", "supervisorName", "date", "scores", "average", "timestamp"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "Collection of system users."
    },
    "attendance": {
      "schema": "AttendanceLog",
      "description": "Collection of attendance records."
    },
    "products": {
      "schema": "Product",
      "description": "Collection of inventory items."
    },
    "inventoryMovements": {
      "schema": "InventoryMovement",
      "description": "Collection of inventory movement history."
    },
    "workLogs": {
      "schema": "WorkLog",
      "description": "Collection of daily work reports."
    },
    "wishlist": {
      "schema": "WishListItem",
      "description": "Collection of daily needs/wishlist items."
    },
    "settings": {
      "schema": "ProjectContext",
      "description": "Global application and project settings."
    },
    "skillEvaluations": {
      "schema": "SkillEvaluation",
      "description": "Collection of daily personnel evaluations."
    }
  }
}
